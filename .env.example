# Deixe as variáveis do Supabase vazias (ou NEXT_PUBLIC_DEMO_MODE=true) para o modo visitação com dados fictícios.
# NEXT_PUBLIC_DEMO_MODE=true

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Somente no servidor (NUNCA exponha no cliente). Usada para criar contas de acesso.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# URL pública do sistema (links de redefinição de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo para assinar os QR Codes de check-in (mín. 32 caracteres aleatórios)
# Gere com: openssl rand -base64 48
CHECKIN_TOKEN_SECRET=troque-por-um-segredo-aleatorio-longo
